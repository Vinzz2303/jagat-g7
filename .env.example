# Copy only the keys you need into the real .env. Never commit real credentials.
# The ledger is deliberately OPT-IN. Take a snapshot of Redis first.
JAGAT_MISSION_LEDGER_ENABLED=false
JAGAT_MISSION_LEDGER_PATH=data/jagat-mission-ledger.sqlite
# Shell execution is disabled by default; never enable on an unsandboxed RDP.
JAGAT_ALLOW_AGENT_SHELL=false
